{
  "name": "frontier",
  "version": "1.3.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "bootstrap": "bun install && bun run build",
    "postinstall": "husky",
    "format": "prettier --write .",
    "lint": "eslint 'src/**/*.{ts,tsx}' --fix",
    "check:type": "tsc --noEmit",
    "check:dependency": "bun install -y",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:headed": "playwright test --headed",
    "dev": "cross-env rsbuild dev",
    "build": "cross-env rsbuild build",
    "build:analyze": "cross-env BUNDLE_ANALYZE=true rsbuild build",
    "preview": "cross-env rsbuild preview",
    "serve": "sirv build --cors --single --host",
    "pack:test": "sh scripts/pack.spec.sh",
    "pack": "sh scripts/pack.sh"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/themes": "^3.1.1",
    "preact": "^10.10.0",
    "preact-router": "^3.2.1",
    "ua-parser-js": "^1.0.38",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@rsbuild/core": "^1.0.1",
    "@rsbuild/plugin-preact": "^1.0.1",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/eslint__js": "^8.42.3",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript-eslint/eslint-plugin": "^5.30.6",
    "@typescript-eslint/parser": "^5.30.6",
    "cross-env": "^7.0.3",
    "eslint": "^8.20.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.1",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3",
    "sirv-cli": "^2.0.2",
    "typescript": "^4.5.2",
    "typescript-eslint": "^7.16.1"
  }
}
